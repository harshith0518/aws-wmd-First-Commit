# Copy to .env at the repository root. Never commit credentials or .env.
APP_ENV=local
HOST=127.0.0.1
PORT=3001
AWS_REGION=ap-south-1
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
CORE_TABLE=campusfix-local-core
DISCOVERY_TABLE=campusfix-local-discovery
JOBS_TABLE=campusfix-local-jobs
# Supply all three from one real Cognito public app client, code+PKCE enabled.
# COGNITO_ISSUER=https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_POOL
# COGNITO_CLIENT_ID=
# COGNITO_DOMAIN=https://YOURDOMAIN.auth.ap-south-1.amazoncognito.com
# Required in production. Use a random secret of at least 32 characters.
# CURSOR_SECRET=
# Browser-public configuration only. Never add a client secret or AWS credentials.
# VITE_COGNITO_ISSUER=https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_POOL
# VITE_COGNITO_CLIENT_ID=
# VITE_COGNITO_DOMAIN=https://YOURDOMAIN.auth.ap-south-1.amazoncognito.com
# VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
