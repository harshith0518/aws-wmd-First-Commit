{
  "name": "campusfix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace @campusfix/api && npm run build --workspace @campusfix/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run specs:check && npm run typecheck && npm test && npm run build",
    "specs:check": "node scripts/validate-specs.mjs",
    "test:integration": "npm run test:integration --workspace @campusfix/api",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.ts\" \"scripts/*.mjs\"",
    "test:browser": "node --import tsx scripts/browser-test-server.ts"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
