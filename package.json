{
  "name": "campusfix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace @campusfix/api && npm run build --workspace @campusfix/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run specs:check && npm run typecheck && npm test && npm run build && npm run infra:check && npm run demo:check",
    "specs:check": "node scripts/validate-specs.mjs",
    "test:integration": "npm run test:integration --workspace @campusfix/api",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.ts\" \"scripts/*.mjs\"",
    "test:browser": "node --import tsx scripts/browser-test-server.ts",
    "aws:package": "node scripts/aws/package-lambda.mjs",
    "aws:synth": "node node_modules/aws-cdk/bin/cdk synth --app \"node --import tsx infra/app.ts\" --output .artifacts/cdk.out --quiet",
    "aws:deploy": "node scripts/aws/deploy.mjs",
    "aws:publish": "node scripts/aws/publish.mjs",
    "aws:smoke": "node scripts/aws/smoke.mjs",
    "aws:seed": "node --import tsx scripts/aws/seed-demo.ts",
    "infra:check": "tsc -p infra/tsconfig.json && node --import tsx --test infra/test/*.test.ts",
    "demo": "node scripts/demo/start.mjs",
    "demo:reset": "node scripts/demo/start.mjs --reset",
    "demo:check": "tsc -p scripts/demo/tsconfig.json && node --import tsx --test scripts/demo/test/*.test.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1136.0",
    "@types/node": "24.12.0",
    "aws-cdk": "2.1142.0",
    "aws-cdk-lib": "2.270.0",
    "constructs": "10.8.1",
    "esbuild": "0.28.2",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
